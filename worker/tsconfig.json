{
  // The Worker runs on workerd, not in a browser: its own types, and no DOM lib.
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "../lib/origin.ts", "../lib/gate.ts", "../lib/room/dungeon-room.ts", "../lib/room/snapshot.ts", "../lib/room/positive-ms.ts"]
}
