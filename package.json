{
  "name": "critical-answer",
  "version": "0.70.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "trap 'kill $! 2>/dev/null' EXIT; npm run dev:worker & NEXT_PUBLIC_PARTYKIT_HOST=localhost:8787 next dev",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:bundle": "next build && sh scripts/check-bundle.sh",
    "check:docs": "node scripts/check-docs.ts",
    "test:live": "LIVE=1 vitest run lib/narration/llm.live.test.ts",
    "playtest": "sh scripts/playtest.sh start",
    "playtest:stop": "sh scripts/playtest.sh stop",
    "dev:worker": "wrangler dev --var ALLOWED_ORIGINS:*"
  },
  "dependencies": {
    "next": "16.4.5",
    "partyserver": "^0.5.10",
    "partysocket": "^1.1.18",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": ">=11.0.1"
    }
  }
}
