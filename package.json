{
  "name": "critical-answer",
  "version": "0.9.2",
  "private": true,
  "scripts": {
    "dev": "concurrently \"NEXT_PUBLIC_PARTYKIT_HOST=localhost:8787 next dev\" \"wrangler dev --var ALLOWED_ORIGINS:*\"",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:bundle": "next build && sh scripts/check-bundle.sh",
    "test:live": "LIVE=1 vitest run lib/narration/llm.live.test.ts",
    "playtest": "sh scripts/playtest.sh start",
    "playtest:stop": "sh scripts/playtest.sh stop",
    "dev:worker": "wrangler dev --var ALLOWED_ORIGINS:*",
    "typecheck:worker": "tsc --noEmit -p worker"
  },
  "dependencies": {
    "next": "16.3.6",
    "partyserver": "^0.5.10",
    "partysocket": "^1.1.18",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  }
}
