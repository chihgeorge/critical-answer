{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "critical-answer",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    // The binding name "main" makes partysocket's default path (/parties/main/<room>) reach the room.
    // "bank" is reached only via RPC from worker/index.ts's own /api/bank/* route and Room.onStart(),
    // never through routePartykitRequest — see lib/gate.ts's header comment.
    "bindings": [
      { "name": "main", "class_name": "Room" },
      { "name": "bank", "class_name": "BankStoreDO" }
    ]
  },
  // Cloudflare's free plan only allows SQLite-backed Durable Objects. Migrations only ever move forward.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["BankStoreDO"] }
  ],
  // The public workers.dev URL is the only door. Per-version preview URLs would be a second, unlisted one.
  "workers_dev": true,
  "preview_urls": false,
  // Browser origins allowed to open a WebSocket or call /api/bank. Local runs override it in
  // .dev.vars (see .dev.vars.example). The wildcard matches Vercel preview deploy URLs, per
  // lib/origin.ts's doc comment; the frontend's first production deploy is
  // https://critical-answer.vercel.app (2026-09-22).
  //
  // R2_PUBLIC_BASE_URL is the "images" bucket's public r2.dev URL. A fork deploying its own Worker
  // creates its own bucket, enables r2.dev public access in the dashboard (see
  // docs/designs/image-question-type.md's Dependencies section) and puts its own URL here, and
  // replaces ALLOWED_ORIGINS with its own frontend's origins.
  "vars": {
    "ALLOWED_ORIGINS": "https://critical-answer.vercel.app,https://critical-answer-*.vercel.app",
    "R2_PUBLIC_BASE_URL": "https://pub-86b65422a566486d8227ac280553f081.r2.dev"
  },
  // Question-bank images (docs/designs/image-question-type.md). Public read access via the
  // bucket's r2.dev subdomain must be enabled manually in the dashboard — not part of `wrangler
  // deploy` — before uploaded images will actually be servable.
  "r2_buckets": [{ "binding": "images", "bucket_name": "critical-answer-images" }],
  "observability": { "enabled": true }
}
