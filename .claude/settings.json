{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__claude-in-chrome__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/rules-guard.mts\" ] && node \"$CLAUDE_PROJECT_DIR/scripts/rules-guard.mts\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/stop-lint.mts\" ] && node \"$CLAUDE_PROJECT_DIR/scripts/stop-lint.mts\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
